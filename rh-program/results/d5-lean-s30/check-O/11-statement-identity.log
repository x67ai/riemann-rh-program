          tiltedPrimeSide a g = ∑ n ∈ Finset.range (⌊Real.exp L⌋₊ + 1),
            ((ArithmeticFunction.vonMangoldt n : ℝ) : ℂ) * (((n : ℝ) ^ (-a) : ℝ) : ℂ) * g (Real.log n)
