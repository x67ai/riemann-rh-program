\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Branches of zeros of $F_t$, $0 \le t \le 1$, in the window $W$ given by the ranges of $\operatorname  {Re}z$ and $\operatorname  {Im}z$. Upper block: complete windows, $\operatorname  {Re}z \le 2\pi (k+2)^2 + 30$; lower block: windows around the landings, branches that start in them. Real, non-real: zeros of $\Xi _k$ / $\Xi _{k+1}$ in $W$ (${}^*$: real zeros in the window). B: branches followed; L: landings; E: ends at a non-real zero of $\Xi _{k+1}$; X: exits through the side of $W$. $\Delta ^+$: the largest change of $\operatorname  {Im}z$ over one step, all branches (negative: $\operatorname  {Im}z$ decreased at every step). $m$: the smallest margin $-\operatorname  {Im}S_k'/|S_k'|$ above height $10^{-6}$. Floating point, not interval arithmetic.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:census}{{1}{7}{Branches of zeros of $F_t$, $0 \le t \le 1$, in the window $W$ given by the ranges of $\re z$ and $\im z$. Upper block: complete windows, $\re z \le 2\pi (k+2)^2 + 30$; lower block: windows around the landings, branches that start in them. Real, non-real: zeros of $\Xi _k$ / $\Xi _{k+1}$ in $W$ (${}^*$: real zeros in the window). B: branches followed; L: landings; E: ends at a non-real zero of $\Xi _{k+1}$; X: exits through the side of $W$. $\Delta ^+$: the largest change of $\im z$ over one step, all branches (negative: $\im z$ decreased at every step). $m$: the smallest margin $-\im S_k'/|S_k'|$ above height $10^{-6}$. Floating point, not interval arithmetic}{table.1}{}}
