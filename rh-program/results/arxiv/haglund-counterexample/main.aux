\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Enclosures of $\Xi _{27}(x)$ at the ends of the two real-zero intervals. Certificate A: balls as printed, display rounding included; the Arb radii are $3.3\cdot 10^{-1435}$ (route L, $4800$ bits), $6.0\cdot 10^{-1915}$ (route L, $6400$ bits) and $5.0\cdot 10^{-1138}$ (route T, $256$ bits), and all four evaluations (route T at $256$ and $1024$ bits, route L at $4800$ and $6400$ bits) give the same signs. Certificate B: tail route, box radii at most $6\cdot 10^{-1121}$; its literal route at $4400$ bits (radius about $1$--$2\cdot 10^{-1171}$) agrees to all digits shown and overlaps.}}{12}{table.1}\protected@file@percent }
\newlabel{tab:real}{{1}{12}{Enclosures of $\Xi _{27}(x)$ at the ends of the two real-zero intervals. Certificate A: balls as printed, display rounding included; the Arb radii are $3.3\cdot 10^{-1435}$ (route L, $4800$ bits), $6.0\cdot 10^{-1915}$ (route L, $6400$ bits) and $5.0\cdot 10^{-1138}$ (route T, $256$ bits), and all four evaluations (route T at $256$ and $1024$ bits, route L at $4800$ and $6400$ bits) give the same signs. Certificate B: tail route, box radii at most $6\cdot 10^{-1121}$; its literal route at $4400$ bits (radius about $1$--$2\cdot 10^{-1171}$) agrees to all digits shown and overlaps}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Certified winding numbers $k$ of $\Xi _{27}$ along the boundaries of squares. In certificate A every run with $k = 1$ has total change of argument $6.28318530717959 \pm 4\cdot 10^{-15}$. In certificate B at $r = 10^{-3}$ the smallest lower modulus over the pieces is $5.89\cdot 10^{-1069}$ against the model error $E = 1.36\cdot 10^{-1087}$; at $r = 3.7\cdot 10^{-11}$ it is $1.97\cdot 10^{-1078}$ against $E = 3.51\cdot 10^{-1106}$. The run at $r = 3.5\cdot 10^{-11}$ returns $0$ because the zero lies just outside that square, and the rows with centers $c + 2.5\cdot 10^{-3}$, $c + 1.5\cdot 10^{-10}$ and $c + 0.01$ are zero-free controls.}}{12}{table.2}\protected@file@percent }
\newlabel{tab:wind}{{2}{12}{Certified winding numbers $k$ of $\Xi _{27}$ along the boundaries of squares. In certificate A every run with $k = 1$ has total change of argument $6.28318530717959 \pm 4\cdot 10^{-15}$. In certificate B at $r = 10^{-3}$ the smallest lower modulus over the pieces is $5.89\cdot 10^{-1069}$ against the model error $E = 1.36\cdot 10^{-1087}$; at $r = 3.7\cdot 10^{-11}$ it is $1.97\cdot 10^{-1078}$ against $E = 3.51\cdot 10^{-1106}$. The run at $r = 3.5\cdot 10^{-11}$ returns $0$ because the zero lies just outside that square, and the rows with centers $c + 2.5\cdot 10^{-3}$, $c + 1.5\cdot 10^{-10}$ and $c + 0.01$ are zero-free controls}{table.2}{}}
