--- Hout (trusted, frozen, ChallengeDeps/Separation6.lean) ---
def Hout (t L R : ℝ) : Prop :=
  Summable (fun ρ : Z.outWindow t R => ‖Z.Wsummand (ftest t L) (ftest t L) ρ‖) ∧
    ‖∑' ρ : Z.outWindow t R, Z.Wsummand (ftest t L) (ftest t L) ρ‖ ≤ Real.exp (-L)

