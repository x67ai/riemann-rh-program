    theorem trace_sq_grid_rat :
        ∀ (n : ℕ) (m : ZMod (2 * n + 1) → ℚ),
          ∑ j1 ∈ Finset.Icc (-(n : ℤ)) (n : ℤ), ∑ j2 ∈ Finset.Icc (-(n : ℤ)) (n : ℤ),
