Zeta23.W1.cert_of_checkW1 : ∀ (d : Zeta23.W1.W1Data),
  Zeta23.W1.checkW1 d = true →
    Zeta23.W1.W1EnclOK riemannZeta d →
      Zeta23.W1.RectArgPrinciple riemannZeta →
        (1 ≤ d.m → ∃ ρ, riemannZeta ρ = 0 ∧ 1 / 2 < ρ.re ∧ ρ.re < 1 ∧ Zeta23.W1.T1 d < ρ.im ∧ ρ.im < Zeta23.W1.T2 d) ∧
          (d.m = 0 → ∀ s ∈ Zeta23.W1.W1Rect d, riemannZeta s ≠ 0)
def Zeta23.W1.RectArgPrinciple : (ℂ → ℂ) → Prop :=
fun f =>
  ∀ (s₁ s₂ t₁ t₂ : ℝ),
    1 / 2 < s₁ →
      s₁ ≤ s₂ →
        s₂ < 1 →
          t₁ < t₂ →
            ∀ (U : Set ℂ),
              IsOpen U →
                Zeta23.W1.rectClosed s₁ s₂ t₁ t₂ ⊆ U →
                  DifferentiableOn ℂ f U →
                    (∀ s ∈ Zeta23.W1.rectBdry s₁ s₂ t₁ t₂, f s ≠ 0) →
                      ∃ Z,
                        2 * Real.pi * ↑Z =
                            Zeta23.W1.argIncrement f (Zeta23.W1.cpt s₁ t₁) (Zeta23.W1.cpt s₂ t₁) +
                                  Zeta23.W1.argIncrement f (Zeta23.W1.cpt s₂ t₁) (Zeta23.W1.cpt s₂ t₂) +
                                Zeta23.W1.argIncrement f (Zeta23.W1.cpt s₂ t₂) (Zeta23.W1.cpt s₁ t₂) +
                              Zeta23.W1.argIncrement f (Zeta23.W1.cpt s₁ t₂) (Zeta23.W1.cpt s₁ t₁) ∧
                          (Z = 0 → ∀ s ∈ Zeta23.W1.rectOpen s₁ s₂ t₁ t₂, f s ≠ 0) ∧
                            (1 ≤ Z → ∃ ρ ∈ Zeta23.W1.rectOpen s₁ s₂ t₁ t₂, f ρ = 0)
def Zeta23.W1.RowEnclOK : (ℂ → ℂ) → ℤ → ℤ → Zeta23.W1.W1Row → ℂ × ℂ → Prop :=
fun f K A row zw =>
  (∀ (t : ℝ),
      0 ≤ t →
        t ≤ 1 →
          (↑row.reLo ≤ ↑K * (f (Zeta23.W1.segPt zw.1 zw.2 t)).re ∧
              ↑K * (f (Zeta23.W1.segPt zw.1 zw.2 t)).re ≤ ↑row.reHi) ∧
            ↑row.imLo ≤ ↑K * (f (Zeta23.W1.segPt zw.1 zw.2 t)).im ∧
              ↑K * (f (Zeta23.W1.segPt zw.1 zw.2 t)).im ≤ ↑row.imHi) ∧
    ↑row.argLo ≤ ↑A * (Zeta23.W1.argIncrement f zw.1 zw.2 / (2 * Real.pi)) ∧
      ↑A * (Zeta23.W1.argIncrement f zw.1 zw.2 / (2 * Real.pi)) ≤ ↑row.argHi
