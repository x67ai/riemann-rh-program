Zeta23.W1.rectArgPrinciple_of_local : ∀ (f : ℂ → ℂ), Zeta23.W1.RectArgPrinciple f
Zeta23.W1.rectArgPrinciple_riemannZeta : Zeta23.W1.RectArgPrinciple riemannZeta
def Zeta23.W1.RectArgPrinciple : (ℂ → ℂ) → Prop :=
fun f =>
  ∀ (s₁ s₂ t₁ t₂ : ℝ),
    1 / 2 < s₁ →
      s₁ ≤ s₂ →
        s₂ < 1 →
          t₁ < t₂ →
            ∀ (U : Set ℂ),
              IsOpen U →
                Zeta23.W1.rectClosed s₁ s₂ t₁ t₂ ⊆ U →
                  DifferentiableOn ℂ f U →
                    (∀ s ∈ Zeta23.W1.rectBdry s₁ s₂ t₁ t₂, f s ≠ 0) →
                      ∃ Z,
                        2 * Real.pi * ↑Z =
                            Zeta23.W1.argIncrement f (Zeta23.W1.cpt s₁ t₁) (Zeta23.W1.cpt s₂ t₁) +
                                  Zeta23.W1.argIncrement f (Zeta23.W1.cpt s₂ t₁) (Zeta23.W1.cpt s₂ t₂) +
                                Zeta23.W1.argIncrement f (Zeta23.W1.cpt s₂ t₂) (Zeta23.W1.cpt s₁ t₂) +
                              Zeta23.W1.argIncrement f (Zeta23.W1.cpt s₁ t₂) (Zeta23.W1.cpt s₁ t₁) ∧
                          (Z = 0 → ∀ s ∈ Zeta23.W1.rectOpen s₁ s₂ t₁ t₂, f s ≠ 0) ∧
                            (1 ≤ Z → ∃ ρ ∈ Zeta23.W1.rectOpen s₁ s₂ t₁ t₂, f ρ = 0)
