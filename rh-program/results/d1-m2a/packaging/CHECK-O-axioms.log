  DBN.BarrierEnclOK (fun t z => DBN.Ht t z / DBN.Bt t z) DBN.row2BarrierMP →
    DBN.AsymEnclOK (fun z => DBN.Ht (93 / 500) z / DBN.Bt (93 / 500) z) DBN.row2AsymMP →
