def Zeta23.W1.kappaDH : ℝ :=
(√(10 - 2 * √5) - 2) / (√5 - 1)
def Zeta23.W1.fDH : ℂ → ℂ :=
fun s =>
  5 ^ (-s) *
    (HurwitzZeta.hurwitzZeta (↑(1 / 5)) s + ↑Zeta23.W1.kappaDH * HurwitzZeta.hurwitzZeta (↑(2 / 5)) s -
        ↑Zeta23.W1.kappaDH * HurwitzZeta.hurwitzZeta (↑(3 / 5)) s -
      HurwitzZeta.hurwitzZeta (↑(4 / 5)) s)
