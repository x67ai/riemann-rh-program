Zeta23.W1.cert_of_checkW1_fDH : ∀ (d : Zeta23.W1.W1Data),
  Zeta23.W1.checkW1 d = true →
    Zeta23.W1.W1EnclOK Zeta23.W1.fDH d →
      (1 ≤ d.m → ∃ ρ, Zeta23.W1.fDH ρ = 0 ∧ 1 / 2 < ρ.re ∧ ρ.re < 1 ∧ Zeta23.W1.T1 d < ρ.im ∧ ρ.im < Zeta23.W1.T2 d) ∧
        (d.m = 0 → ∀ s ∈ Zeta23.W1.W1Rect d, Zeta23.W1.fDH s ≠ 0)
Zeta23.W1.mpDH_zero : Zeta23.W1.W1EnclOK Zeta23.W1.fDH Zeta23.W1.mpDH →
  ∃ ρ, Zeta23.W1.fDH ρ = 0 ∧ 1 / 2 < ρ.re ∧ ρ.re < 1 ∧ 8569 / 100 < ρ.im ∧ ρ.im < 8571 / 100
Zeta23.W1.arbDH_zero : Zeta23.W1.W1EnclOK Zeta23.W1.fDH Zeta23.W1.arbDH →
  ∃ ρ, Zeta23.W1.fDH ρ = 0 ∧ 1 / 2 < ρ.re ∧ ρ.re < 1 ∧ 8569 / 100 < ρ.im ∧ ρ.im < 8571 / 100
Zeta23.W1.cert_of_checkW1_ap : ∀ (d : Zeta23.W1.W1Data),
  Zeta23.W1.checkW1 d = true →
    Zeta23.W1.W1EnclOK riemannZeta d →
      (1 ≤ d.m → ∃ ρ, riemannZeta ρ = 0 ∧ 1 / 2 < ρ.re ∧ ρ.re < 1 ∧ Zeta23.W1.T1 d < ρ.im ∧ ρ.im < Zeta23.W1.T2 d) ∧
        (d.m = 0 → ∀ s ∈ Zeta23.W1.W1Rect d, riemannZeta s ≠ 0)
Zeta23.W1.cert_of_checkW1 : ∀ (d : Zeta23.W1.W1Data),
  Zeta23.W1.checkW1 d = true →
    Zeta23.W1.W1EnclOK riemannZeta d →
      Zeta23.W1.RectArgPrinciple riemannZeta →
        (1 ≤ d.m → ∃ ρ, riemannZeta ρ = 0 ∧ 1 / 2 < ρ.re ∧ ρ.re < 1 ∧ Zeta23.W1.T1 d < ρ.im ∧ ρ.im < Zeta23.W1.T2 d) ∧
          (d.m = 0 → ∀ s ∈ Zeta23.W1.W1Rect d, riemannZeta s ≠ 0)
Zeta23.W1.cert_of_checkW1_of_diffOn : ∀ (f : ℂ → ℂ),
  DifferentiableOn ℂ f {s | s.re < 1} →
    ∀ (d : Zeta23.W1.W1Data),
      Zeta23.W1.checkW1 d = true →
        Zeta23.W1.W1EnclOK f d →
          Zeta23.W1.RectArgPrinciple f →
            (1 ≤ d.m → ∃ ρ, f ρ = 0 ∧ 1 / 2 < ρ.re ∧ ρ.re < 1 ∧ Zeta23.W1.T1 d < ρ.im ∧ ρ.im < Zeta23.W1.T2 d) ∧
              (d.m = 0 → ∀ s ∈ Zeta23.W1.W1Rect d, f s ≠ 0)
Zeta23.W1.differentiable_fDH : Differentiable ℂ Zeta23.W1.fDH
@Zeta23.W1.hasSum_hurwitzZeta_one_fifth : ∀ {s : ℂ},
  1 < s.re → HasSum (fun n => 1 / (↑n + ↑(1 / 5)) ^ s) (HurwitzZeta.hurwitzZeta (↑(1 / 5)) s)
@Zeta23.W1.continuousOn_logDeriv_seg_of_diffOn : ∀ {f : ℂ → ℂ} {U : Set ℂ},
  IsOpen U →
    DifferentiableOn ℂ f U →
      ∀ {z w : ℂ},
        (∀ (t : ℝ), 0 ≤ t → t ≤ 1 → Zeta23.W1.segPt z w t ∈ U) →
          (∀ (t : ℝ), 0 ≤ t → t ≤ 1 → f (Zeta23.W1.segPt z w t) ≠ 0) →
            ContinuousOn (fun t => deriv f (Zeta23.W1.segPt z w t) / f (Zeta23.W1.segPt z w t) * (w - z)) (Set.Icc 0 1)
@Zeta23.W1.continuousOn_zeta_logDeriv_seg : ∀ {z w : ℂ},
  (∀ (t : ℝ), 0 ≤ t → t ≤ 1 → (Zeta23.W1.segPt z w t).re < 1) →
    (∀ (t : ℝ), 0 ≤ t → t ≤ 1 → riemannZeta (Zeta23.W1.segPt z w t) ≠ 0) →
      ContinuousOn (fun t => deriv riemannZeta (Zeta23.W1.segPt z w t) / riemannZeta (Zeta23.W1.segPt z w t) * (w - z))
        (Set.Icc 0 1)
